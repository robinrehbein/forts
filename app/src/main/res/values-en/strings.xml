    <!-- Tutorial (WP14b) -->
    <string name="tutorial_offer_title">First battle?</string>
    <string name="tutorial_offer_body">The tutorial walks you through building, economy and shooting in three short steps. It takes about two minutes, and the enemy waits.</string>
    <string name="tutorial_offer_start">Start tutorial</string>
    <string name="tutorial_offer_later">Later</string>
    <string name="tutorial_step">Step %1$d / %2$d</string>
    <string name="tutorial_skip">Skip</string>
    <string name="tutorial_step1_title">Build a beam</string>
    <string name="tutorial_step2_title">Build a mine</string>
    <string name="tutorial_step3_title">Fire the mortar</string>
    <string name="tutorial_pick_wood">Tap WOOD below to pick a wooden beam.</string>
    <string name="tutorial_draw_beam">Drag from one pulsing node to the other.</string>
    <string name="tutorial_pick_mine">Tap MINE below. It produces metal, but only above ore.</string>
    <string name="tutorial_place_mine">Tap the marker above the ore to place the mine.</string>
    <string name="tutorial_enter_aim">Switch to aim mode with AIM.</string>
    <string name="tutorial_aim_fire">Drag in the shot direction, then tap FIRE. The drag length sets the power.</string>
    <string name="tutorial_aim_release">Drag in the shot direction and let go to fire. The drag length sets the power.</string>
    <string name="tutorial_back_to_build">Switch back to build mode with BUILD.</string>
    <string name="tutorial_drag_label">Drag direction = shot direction</string>
    <string name="tutorial_ore_label">Ore</string>
    <string name="tutorial_done_title">Tutorial complete</string>
    <string name="tutorial_done_body">Well done! Now the enemy strikes back: defend your fortress and destroy their reactor.</string>
    <string name="tutorial_done_continue">Continue</string>

